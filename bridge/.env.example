# The wallet address your customers' signed actions are addressed to (the business wallet that proposed the agreements). Required.
LISTEN_ADDRESS=0x0000000000000000000000000000000000000000

# Where to send notices: Slack/Discord incoming webhook, Zapier/Make catch hook, or any URL that accepts JSON. Optional.
WEBHOOK_URL=
# json (default), slack or discord
WEBHOOK_FORMAT=json

# Optional: a wallet used ONLY to pay gas for submitting your customers' signed actions. Put a few cents of OKB in it, never more.
# Leave empty to get notices only (someone then submits from the #inbox page).
RELAYER_PRIVATE_KEY=

# Optional: tell reviewers when a case waits for them. address=webhook, comma separated.
REVIEWER_HOOKS=

# Safety: most actions submitted per UTC day.
DAILY_CAP=25

# Defaults target X Layer mainnet and the live site.
RPC_URL=https://rpc.xlayer.tech
PUBLIC_URL=https://lgtie.vercel.app/
